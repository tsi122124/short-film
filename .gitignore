# Secrets: never committed. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Large intermediate media. Final films, references, keyframes, narration and
# experiment outputs stay tracked so the run can be inspected; regenerable
# assembly intermediates (15 MB WAV mixes) do not.
outputs/assembly/
outputs/_scratch/
# camera-move clips are rebuilt deterministically from the keyframes; Wan clips (outputs/wan/) are kept
outputs/shots/
outputs/**/*.part

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Reference photos shared privately with permission; never published
assets/private/

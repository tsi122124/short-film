# Copy this file to .env (which is gitignored) and paste your own values.
# Never commit .env or paste keys into chats, issues or logs.

# Google AI Studio -> Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare dashboard -> Workers AI -> "Use REST API":
# the Account ID, and an API token with the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Addis AI (Amharic voices) for the TTS comparison: https://addisassistant.com/apikeys
ADDIS_API_KEY=

# Optional: full path to ffmpeg if it is not on your PATH
FFMPEG=
